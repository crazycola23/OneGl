# Runtime storage (auth state, runs, screenshots, HTML snapshots)
ONEGL_DATA_DIR=.onegl

# --- Browser storageState encryption ----------------------------------------
# Production: inject this from your secret manager. It must decode to exactly 32 bytes.
# Example generation: printf 'base64:' && openssl rand -base64 32
# Do not commit the generated value to the repository.
# ONEGL_STORAGE_STATE_KEY=base64:replace-with-32-random-bytes
# When true, browser/auth startup fails closed unless a valid key is configured. Recommended in production.
# ONEGL_REQUIRE_STORAGE_STATE_ENCRYPTION=true

# Camoufox remains supported for compatibility with the existing collector. For routine
# authorised monitoring, a normal visible Chromium/Firefox installation is the lower-complexity
# option when it works reliably with the current Doubao UI.
ONEGL_BROWSER=camoufox
ONEGL_CAMOUFOX_PYTHON=python3
ONEGL_HEADLESS=false

# 浏览器上下文环境。同一个账号每次冷启动都应当呈现同一套 locale/时区/窗口，
# 否则 Worker 重启后看起来就像换了一台设备。填你真实使用的值即可。
ONEGL_BROWSER_LOCALE=zh-CN
ONEGL_BROWSER_TIMEZONE=Asia/Shanghai
ONEGL_BROWSER_VIEWPORT_WIDTH=1440
ONEGL_BROWSER_VIEWPORT_HEIGHT=900

# Optional normal local browser. playwright-core does not download browsers itself.
# ONEGL_BROWSER=chromium
# ONEGL_BROWSER_EXECUTABLE=/path/to/browser

DOUBAO_URL=https://www.doubao.com/chat/
DOUBAO_TIMEOUT_MS=180000
DOUBAO_POLL_MS=1500
DOUBAO_STABLE_POLLS=3
DOUBAO_LOGIN_TIMEOUT_MS=300000
# 等待「会话确实已清空」的最长时间。超时未确认就拒绝发送该 Prompt
DOUBAO_CONVERSATION_SETTLE_MS=15000

# 前端保守操作闸门
ONEGL_FRONTEND_IDLE_WAIT_MS=60000
ONEGL_FRONTEND_GUARD_POLL_MS=750
ONEGL_FRONTEND_STABLE_IDLE_POLLS=3

# --- 实验性 Network / SSE provenance ---------------------------------------
# ONEGL_NETWORK_EVIDENCE=true
ONEGL_NETWORK_MAX_BODY_BYTES=4194304
ONEGL_NETWORK_BODY_TIMEOUT_MS=8000

# --- Retrieved-page evidence ------------------------------------------------
ONEGL_PAGE_CONCURRENCY=4
ONEGL_PAGE_TIMEOUT_MS=10000
ONEGL_PAGE_MAX_BYTES=2097152
ONEGL_PAGE_DOMAIN_SPACING_MS=1500
# ONEGL_TRUST_PROXY_FAKE_IP=true

# Internal/local Admin Console
ONEGL_PORT=3100

# --- Service API -------------------------------------------------------------
# 独立于 Admin Console 的服务端 API。跨机器部署时建议仍监听私网/回环地址，
# 由 TLS reverse proxy / private network 暴露给你的产品后端。
ONEGL_API_HOST=127.0.0.1
ONEGL_API_PORT=3200

# Master key 只用于初始化 tenant / tenant API client，以及内部管理调用。
# 业务平台平时应使用数据库里生成的 tenant client key，不要长期使用 master key。
# ONEGL_API_KEY=replace-with-a-long-random-master-secret

# Webhook 使用 HMAC-SHA256 签名。每个 endpoint 的 signing secret 从该根密钥派生，
# 创建 endpoint 时只返回给调用方；数据库不保存 webhook secret 明文。
# ONEGL_WEBHOOK_SIGNING_KEY=replace-with-a-second-long-random-secret
ONEGL_WEBHOOK_POLL_MS=2000
ONEGL_WEBHOOK_TIMEOUT_MS=10000
ONEGL_WEBHOOK_MAX_ATTEMPTS=5
# 默认 webhook URL 必须 HTTPS。本地开发确需 http:// 时才临时打开。
# 即使允许 HTTP，投递层仍拒绝 loopback / private / link-local / reserved IP，且不跟随重定向。
# ONEGL_WEBHOOK_ALLOW_HTTP=true

# 远程账号绑定：API 启动一个临时受限浏览器会话，主平台后端轮询截图供用户扫码登录。
# 不返回 Cookie/storageState；不暴露任意 click/type 接口。runtime owner/heartbeat/截图/取消
# 会写 PostgreSQL，因此轮询请求可以落到不同 API 节点；实际浏览器仍只由一个 owner 节点持有。
ONEGL_REMOTE_AUTH_HEADLESS=true
ONEGL_REMOTE_AUTH_POLL_MS=1500
# owner 心跳超过该时间视为浏览器节点失联；新节点可在后续恢复流程中接管新的 auth session。
ONEGL_REMOTE_AUTH_OWNER_TIMEOUT_MS=30000

# --- Doubao recurring monitoring -------------------------------------------
# monitor:worker 检查“到期计划”的轮询间隔。它只决定多久检查一次数据库，
# 不会改变豆包提问间隔、小时/每日额度或账号冷却策略。
ONEGL_MONITOR_TICK_MS=30000

# --- PostgreSQL persistence -------------------------------------------------
# DATABASE_URL=postgresql://onegl:<password>@127.0.0.1:15432/onegl

# --- SSH tunnel -------------------------------------------------------------
# ONEGL_SSH_TARGET=root@db-host
# ONEGL_DB_TUNNEL_PORT=15432
# ONEGL_DB_REMOTE_HOST=127.0.0.1
# ONEGL_DB_REMOTE_PORT=5432
# ONEGL_REDIS_TUNNEL_PORT=16380
# ONEGL_REDIS_REMOTE_PORT=6380
# ONEGL_TUNNEL_DB=0
# ONEGL_TUNNEL_REDIS=0

# --- 后台队列 ---------------------------------------------------------------
# REDIS_URL=redis://:<password>@127.0.0.1:16380
# ONEGL_QUEUE_PREFIX=onegl
# 多 Worker 同时抢到相同账号或全局并发 slot 时，不执行浏览器动作，而是延后再抢锁。
ONEGL_ACCOUNT_LOCK_RETRY_MS=15000

# --- 账号安全层 -------------------------------------------------------------
# 这些是 OneGl 的保守默认值，不代表豆包官方公布的限制。
ONEGL_MIN_DELAY_MS=30000
ONEGL_MAX_DELAY_MS=90000
ONEGL_MIN_INTER_RUN_SECONDS=45
ONEGL_ACCOUNT_HOURLY_LIMIT=10
ONEGL_ACCOUNT_TIMEZONE=Asia/Shanghai
ONEGL_ACCOUNT_DAILY_LIMIT=40
ONEGL_MAX_CONSECUTIVE_FAILURES=3
ONEGL_ACCOUNT_COOLDOWN_MINUTES=60
ONEGL_RATE_LIMIT_COOLDOWN_MINUTES=180
# 现在由 PostgreSQL advisory-lock global slots 跨所有 worker 进程共同执行该上限。
ONEGL_ACCOUNT_PARALLELISM=1
