# Runtime storage (auth state, runs, screenshots, HTML snapshots)
ONEGL_DATA_DIR=.onegl

# camoufox is the default browser backend.
ONEGL_BROWSER=camoufox
ONEGL_CAMOUFOX_PYTHON=python3
ONEGL_HEADLESS=false

# Optional fallback browser. playwright-core does not download browsers itself,
# so set this when ONEGL_BROWSER=chromium or firefox.
# ONEGL_BROWSER_EXECUTABLE=/path/to/browser

DOUBAO_URL=https://www.doubao.com/chat/
DOUBAO_TIMEOUT_MS=180000
DOUBAO_POLL_MS=1500
DOUBAO_STABLE_POLLS=3
DOUBAO_LOGIN_TIMEOUT_MS=300000

# Read-only local verification dashboard
ONEGL_PORT=3100

# --- PostgreSQL persistence (v0.2) ------------------------------------------
# Optional. When unset the collector runs artifact-only, exactly as in Phase 0.
# Never commit a real value: this file is an example, and .env is gitignored.
#
# The database only listens on the server's loopback interface, so a collector
# running elsewhere reaches it through `npm run db:tunnel` and points at the
# local end of the tunnel:
# DATABASE_URL=postgresql://onegl:<password>@127.0.0.1:15432/onegl

# --- SSH tunnel (only needed when the collector is not on the database host) --
# ONEGL_SSH_TARGET=user@db-host
# ONEGL_DB_TUNNEL_PORT=15432
# ONEGL_DB_REMOTE_HOST=127.0.0.1
# ONEGL_DB_REMOTE_PORT=5432
