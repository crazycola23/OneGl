# Runtime storage (auth state, runs, screenshots, HTML snapshots)
ONEGL_DATA_DIR=.onegl

# camoufox is the default browser backend.
ONEGL_BROWSER=camoufox
ONEGL_CAMOUFOX_PYTHON=python3
ONEGL_HEADLESS=false

# Optional fallback browser. playwright-core does not download browsers itself,
# so set this when ONEGL_BROWSER=chromium or firefox.
# ONEGL_BROWSER_EXECUTABLE=/path/to/browser

DOUBAO_URL=https://www.doubao.com/chat/
DOUBAO_TIMEOUT_MS=180000
DOUBAO_POLL_MS=1500
DOUBAO_STABLE_POLLS=3
DOUBAO_LOGIN_TIMEOUT_MS=300000

# Read-only local verification dashboard
ONEGL_PORT=3100

# --- PostgreSQL persistence (v0.2) ------------------------------------------
# Optional. When unset the collector runs artifact-only, exactly as in Phase 0.
# Never commit a real value: this file is an example, and .env is gitignored.
#
# The database only listens on the server's loopback interface, so a collector
# running elsewhere reaches it through `npm run db:tunnel` and points at the
# local end of the tunnel:
# DATABASE_URL=postgresql://onegl:<password>@127.0.0.1:15432/onegl

# --- SSH tunnel -------------------------------------------------------------
# The collector always runs on this machine (it needs a real browser with a
# logged-in Doubao session), while PostgreSQL and Redis only listen on the
# server's loopback interface. `npm run db:tunnel` maps both to local ports in
# one command, so DATABASE_URL / REDIS_URL point at the local end of that tunnel
# and no firewall port is ever opened.
# ONEGL_SSH_TARGET=root@db-host
# ONEGL_DB_TUNNEL_PORT=15432
# ONEGL_DB_REMOTE_HOST=127.0.0.1
# ONEGL_DB_REMOTE_PORT=5432
# ONEGL_REDIS_TUNNEL_PORT=16380
# ONEGL_REDIS_REMOTE_PORT=6380
# Set to 0 to skip one side of the tunnel.
# ONEGL_TUNNEL_DB=0
# ONEGL_TUNNEL_REDIS=0

# --- 后台队列 (v0.5) ---------------------------------------------------------
# 可选。未配置时网页「开始监测」会提示不可用，命令行 batch:run 仍可执行。
# Redis 只发布在服务器的 127.0.0.1:6380，本机经 `npm run db:tunnel` 访问，
# 绝不开放公网端口。端口要与 ONEGL_REDIS_TUNNEL_PORT 一致。
# REDIS_URL=redis://:<password>@127.0.0.1:16380
# ONEGL_QUEUE_PREFIX=onegl

# --- 账号安全层 --------------------------------------------------------------
# 两次提问之间的随机等待区间（毫秒）
ONEGL_MIN_DELAY_MS=4000
ONEGL_MAX_DELAY_MS=9000
# 单账号每日最多提问次数
ONEGL_ACCOUNT_DAILY_LIMIT=60
# 连续失败多少次后进入冷却
ONEGL_MAX_CONSECUTIVE_FAILURES=3
# 冷却时长（分钟）
ONEGL_ACCOUNT_COOLDOWN_MINUTES=30
# 同时并行的账号数。单账号内部恒定串行，1 表示同一时间只跑一个账号
ONEGL_ACCOUNT_PARALLELISM=1
