# Runtime storage (auth state, runs, screenshots, HTML snapshots)
ONEGL_DATA_DIR=.onegl

# Explicit production safety mode. NODE_ENV=production also enables the same strict checks.
# In production, API/worker startup fails closed when required safety settings are missing.
# ONEGL_PRODUCTION=true

# --- Browser storageState encryption ----------------------------------------
# Production: inject this from your secret manager. It must decode to exactly 32 bytes.
# Example generation: printf 'base64:' && openssl rand -base64 32
# Do not commit the generated value to the repository.
# ONEGL_STORAGE_STATE_KEY=base64:replace-with-32-random-bytes
# When true, browser/auth startup fails closed unless a valid key is configured. Required by production mode.
# ONEGL_REQUIRE_STORAGE_STATE_ENCRYPTION=true
# Key rotation only: stop OneGl, inject the previous key here and the new key above, then run
# npm run storage:rotate -- --dry-run followed by npm run storage:rotate.
# Remove the old key after successful rotation and restart the services.
# ONEGL_STORAGE_STATE_OLD_KEY=base64:previous-32-byte-key

# Camoufox is the intended collector browser. On Linux servers, virtual mode runs a normal
# Camoufox window on an Xvfb display without requiring GNOME/KDE or a physical monitor.
# Modes: virtual (Linux + Xvfb), headless (native headless), headful (real display).
ONEGL_BROWSER=camoufox
ONEGL_CAMOUFOX_PYTHON=python3
ONEGL_CAMOUFOX_MODE=headful
# Chromium/Firefox use this boolean directly. Camoufox uses it only when
# ONEGL_CAMOUFOX_MODE is omitted, preserving backwards compatibility.
ONEGL_HEADLESS=false

# 浏览器上下文环境。同一个账号每次冷启动都应当呈现同一套 locale/时区/窗口，
# 否则 Worker 重启后看起来就像换了一台设备。填你真实使用的值即可。
# Camoufox 默认每次启动随机挑一个操作系统（连带 UA、字体度量、WebGL 厂商），
# 而下面这三项又被 Playwright 钉死，两层会互相矛盾，所以 OS 也必须钉住。
# 取值：windows / macos / linux。
ONEGL_CAMOUFOX_OS=windows
ONEGL_BROWSER_LOCALE=zh-CN
ONEGL_BROWSER_TIMEZONE=Asia/Shanghai
ONEGL_BROWSER_VIEWPORT_WIDTH=1440
ONEGL_BROWSER_VIEWPORT_HEIGHT=900

# Optional normal local browser. playwright-core does not download browsers itself.
# ONEGL_BROWSER=chromium
# ONEGL_BROWSER_EXECUTABLE=/path/to/browser

DOUBAO_URL=https://www.doubao.com/chat/
DOUBAO_TIMEOUT_MS=180000
DOUBAO_POLL_MS=1500
DOUBAO_STABLE_POLLS=3
DOUBAO_LOGIN_TIMEOUT_MS=300000
# 等待「会话确实已清空」的最长时间。超时未确认就拒绝发送该 Prompt
DOUBAO_CONVERSATION_SETTLE_MS=15000

# 前端保守操作闸门
ONEGL_FRONTEND_IDLE_WAIT_MS=60000
ONEGL_FRONTEND_GUARD_POLL_MS=750
ONEGL_FRONTEND_STABLE_IDLE_POLLS=3

# --- 实验性 Network / SSE provenance ---------------------------------------
# ONEGL_NETWORK_EVIDENCE=true
ONEGL_NETWORK_MAX_BODY_BYTES=4194304
ONEGL_NETWORK_BODY_TIMEOUT_MS=8000

# --- Retrieved-page evidence ------------------------------------------------
ONEGL_PAGE_CONCURRENCY=4
ONEGL_PAGE_TIMEOUT_MS=10000
ONEGL_PAGE_MAX_BYTES=2097152
ONEGL_PAGE_DOMAIN_SPACING_MS=1500
# ONEGL_TRUST_PROXY_FAKE_IP=true

# Internal/local Admin Console
ONEGL_PORT=3100

# --- Service API -------------------------------------------------------------
# 独立于 Admin Console 的服务端 API。跨机器部署时建议仍监听私网/回环地址，
# 由 TLS reverse proxy / private network 暴露给你的产品后端。
ONEGL_API_HOST=127.0.0.1
ONEGL_API_PORT=3200

# Master key 只用于初始化 tenant / tenant API client，以及内部管理调用。
# 业务平台平时应使用数据库里生成的 tenant client key，不要长期使用 master key。
# ONEGL_API_KEY=replace-with-a-long-random-master-secret

# --- API observability / abuse control --------------------------------------
# Distributed fixed-window request limit per API credential. 0 disables it; production should keep it enabled.
ONEGL_API_RATE_LIMIT_PER_MINUTE=120
# Audit rows contain metadata only (request id, tenant/client, route, status, duration, error code), never bodies/credentials.
ONEGL_AUDIT_RETENTION_DAYS=30
# Optional Prometheus-compatible /metrics endpoint. When unset, /metrics returns 404.
# Use a separate long random secret; do not reuse ONEGL_API_KEY.
# ONEGL_METRICS_TOKEN=replace-with-a-long-random-metrics-secret

# --- SLO / operations alerts -------------------------------------------------
# Alert Worker only sends aggregate operational state; it never sends prompts, answers, cookies or API credentials.
ONEGL_ALERT_POLL_MS=60000
ONEGL_ALERT_REPEAT_MINUTES=60
ONEGL_ALERT_TIMEOUT_MS=10000
# Production alert worker requires a public HTTPS endpoint without URL credentials.
# ONEGL_ALERT_WEBHOOK_URL=https://ops.example.com/onegl-alerts
# Use a different secret from API/Webhook keys. Alert payloads are HMAC-SHA256 signed.
# ONEGL_ALERT_SIGNING_KEY=replace-with-a-long-random-alert-signing-secret
# Rolling SLO window and thresholds. These defaults are starting guardrails, not Doubao platform limits.
ONEGL_SLO_WINDOW_MINUTES=15
ONEGL_SLO_API_MIN_REQUESTS=20
ONEGL_SLO_API_5XX_RATE_MAX=0.02
ONEGL_SLO_API_P95_MS_MAX=3000
ONEGL_SLO_EXECUTION_MIN_COUNT=5
ONEGL_SLO_EXECUTION_BAD_RATE_MAX=0.20
ONEGL_SLO_MANUAL_ACCOUNTS_MAX=0
ONEGL_SLO_FAILED_WEBHOOKS_MAX=0

# Webhook 使用 HMAC-SHA256 签名。每个 endpoint 的 signing secret 从该根密钥派生，
# 创建 endpoint 时只返回给调用方；数据库不保存 webhook secret 明文。
# Production mode requires at least 32 characters.
# ONEGL_WEBHOOK_SIGNING_KEY=replace-with-a-second-long-random-secret
ONEGL_WEBHOOK_POLL_MS=2000
ONEGL_WEBHOOK_TIMEOUT_MS=10000
ONEGL_WEBHOOK_MAX_ATTEMPTS=5
# 默认 webhook URL 必须 HTTPS。本地开发确需 http:// 时才临时打开。
# 即使允许 HTTP，投递层仍拒绝 loopback / private / link-local / reserved IP，且不跟随重定向。
# Production mode refuses to start when this is true.
# ONEGL_WEBHOOK_ALLOW_HTTP=true

# 远程账号绑定：API 启动一个临时受限浏览器会话，主平台后端轮询截图供用户扫码登录。
# 不返回 Cookie/storageState；不暴露任意 click/type 接口。runtime owner/heartbeat/截图/取消
# 会写 PostgreSQL，因此轮询请求可以落到不同 API 节点；实际浏览器仍只由一个 owner 节点持有。
ONEGL_REMOTE_AUTH_HEADLESS=true
ONEGL_REMOTE_AUTH_POLL_MS=1500
# owner 心跳超过该时间视为浏览器节点失联；新节点可在后续恢复流程中接管新的 auth session。
ONEGL_REMOTE_AUTH_OWNER_TIMEOUT_MS=30000

# --- Doubao recurring monitoring -------------------------------------------
# monitor:worker 检查“到期计划”的轮询间隔。它只决定多久检查一次数据库，
# 不会改变豆包提问间隔、小时/每日额度或账号冷却策略。
ONEGL_MONITOR_TICK_MS=30000

# --- PostgreSQL persistence -------------------------------------------------
# DATABASE_URL=postgresql://onegl:<password>@127.0.0.1:15432/onegl
# 连接池上限，默认 16，下限 4。**不要设成与并发槽位相等。**
# 账号租约是会话级 advisory lock，要独占一条池连接整整一个 attempt（最长 900 秒），
# 它不参与「同时有多少查询在跑」这个直觉算式。2026-09-26 的故障就是 max=4 撞上
# 千问 4 个匿名槽位：池被攥满后零余量，任何其它查询等满 10 秒就抛
# `timeout exceeded when trying to connect`（这句是 node-postgres 的，不是 ioredis 的）。
# 余量按「并发槽位 × 平台数 + 后台短查询（对账 / 账号扫描 / 收尾刷新）」给。
# ONEGL_DB_POOL_MAX=16

# --- SSH tunnel -------------------------------------------------------------
# ONEGL_SSH_TARGET=root@db-host
# ONEGL_DB_TUNNEL_PORT=15432
# ONEGL_DB_REMOTE_HOST=127.0.0.1
# ONEGL_DB_REMOTE_PORT=5432
# ONEGL_REDIS_TUNNEL_PORT=16380
# ONEGL_REDIS_REMOTE_PORT=6380
# ONEGL_TUNNEL_DB=0
# ONEGL_TUNNEL_REDIS=0

# --- 后台队列 ---------------------------------------------------------------
# REDIS_URL=redis://:<password>@127.0.0.1:16380
# ONEGL_QUEUE_PREFIX=onegl
# 多 Worker 同时抢到相同账号或全局并发 slot 时，不执行浏览器动作，而是延后再抢锁。
ONEGL_ACCOUNT_LOCK_RETRY_MS=15000

# --- 采集平台 ---------------------------------------------------------------
# 本进程服务的平台，决定登录态文件名与加密 scope。
# 同一个 ONEGL_ACCOUNT 在不同平台下是两份互不复用的登录凭据。
# 默认 doubao；取值必须是已注册 adapter 的 id。
# ONEGL_ACCOUNT_PROVIDER=doubao

# --- 账号安全层 -------------------------------------------------------------
# 这些是 OneGl 的保守默认值，不代表豆包官方公布的限制。
ONEGL_MIN_DELAY_MS=30000
ONEGL_MAX_DELAY_MS=90000
ONEGL_MIN_INTER_RUN_SECONDS=45
ONEGL_ACCOUNT_HOURLY_LIMIT=10
ONEGL_ACCOUNT_TIMEZONE=Asia/Shanghai
ONEGL_ACCOUNT_DAILY_LIMIT=40
ONEGL_MAX_CONSECUTIVE_FAILURES=3
ONEGL_ACCOUNT_COOLDOWN_MINUTES=60
ONEGL_RATE_LIMIT_COOLDOWN_MINUTES=180
# 现在由 PostgreSQL advisory-lock global slots 跨所有 worker 进程共同执行该上限。
ONEGL_ACCOUNT_PARALLELISM=1
# 每个浏览器窗口服务多少次提问后换新窗口。默认 0 = 不轮换，保持各平台原有会话行为。
# 换窗口清的是对话状态，账号 cookie 与设备指纹都保持不变，不是用来重置平台配额的。
# 需要更强隔离的平台在自己的 profile 里声明（如千问 = 1，每问一个干净会话），不要改这里。
ONEGL_ROUND_PROMPT_LIMIT=0
# 每多少次提问后**重启浏览器进程**换取新的设备指纹。默认 0 = 不重启，一个浏览器进程服务整个
# Worker 生命周期。这是唯一能改指纹的开关：Camoufox 在 launch_options() 里定下指纹，rotateContext
# 只能换对话状态。计数每重启一次归零，所以 N 是「每 N 次重启」，不是「只跑 N 次」。
# 代价是一次完整冷启动（Python 取 launch options + Xvfb + uBlock），别设成 1。
ONEGL_WINDOW_RESET_EVERY=0
# 上面那条的作用域：留空 = 所有平台；写逗号分隔的 provider（如 qianwen）就只对它们生效。
# 用它是为了避免「为一个平台开的轮换」把其它平台的浏览器会话也一起冷启动掉。
ONEGL_WINDOW_RESET_PROVIDERS=
# 千问匿名额度：每轮 4 条之后要静置多久。1500000（25 分钟）是 2026-09-23/24 的实测值，
# 生产当前用 0 关掉这条限制。留着它的原因只是可用性判定还在读这个键 —— 它记录的是一段
# 历史观测（那时每 2 条就换指纹换窗口的前提还没到位），不是「平台一定按轮限额」的结论。
ONEGL_QIANWEN_BURST_PAUSE_MS=1500000
# 千问提交后「一个字符都没出现」的容忍窗，毫秒，默认 180000（3 分钟），下限 30000。
# 越过就抛 ANSWER_NOT_FOUND 提前退出，不再空耗默认 900 秒预算 —— 2026-09-26 批次 68 有 6 条
# 拖满 900 秒而 answerSeen 全程为 0，artifact 显示是平台静默吞了请求（receiving card 在转、
# answer card 从未出现、没有任何拒绝信号）。这类会话等多久都不会出内容，只是白占槽位。
# 判据只认「从未出现过答案」：出过一个字就不再走这条路，所以慢任务不会被误杀。
# 180s 来自实测：同批次 7 条成功采集的首字延迟是 8/8/8/8/6/50/97 秒，中位数 8 秒但尾部到 97 秒。
# worker 日志里的 `[qianwen] first-token Ns` 持续提供这个分布，尾部一旦越过它就该再抬。
ONEGL_ANSWER_FIRST_TOKEN_MS=180000
