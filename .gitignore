node_modules/
.env
deploy/.env.production
.onegl/
.venv/
# 客户交付报告：含具体品牌的监测结论与豆包回答原文，不进公开仓库
reports/
# 客户专属内容（报告 profile 等）：只保留在本地
local/
# 真实客户的项目配置与关键词池：含客户名称与投放关键词策略，只保留在本地
examples/project.qidaifuzhengtang.json
examples/keyword-pool.qidaifuzhengtang.json
.DS_Store
npm-debug.log*
pnpm-debug.log*
# 提交信息临时文件（勿提交）
.commit-msg.tmp

# ★ 例外：remote.mjs 与它的测试要进版本库。
#   忽略这条规则时写的理由是「含 SSH 凭据」，但那已经不成立了 ——
#   口令改成从 ONEGL_SSH_PASSWORD 读，文件里只剩一处说明历史的注释。
#
#   而它必须被跟踪的理由：所有部署、探针、验证都经由它，
#   且它带着防「静默跑旧版本」的护栏（script 会核对本地与远端的 sha256，
#   不一致就拒绝执行）。这种护栏一旦丢失、且没人知道它存在过，
#   就会出现「跑的是旧脚本但输出看起来完全正常」——
#   2026-10-06 因此连续两次误判。
#
# ⚠️ 必须排除**目录**里的内容而不是整个目录：
#     git 不会进入被排除的目录，所以 `!.ops/remote.mjs` 这种
#     对 `.ops/` 的例外是**无效**的（2026-10-06 实测确认）。
#     正确写法是保留 `.ops/` 目录、排除它的内容，再对具体文件开例外。
.ops/*
!.ops/remote.mjs
!.ops/test/
!.ops/test/**

# 排查与冒烟用的临时脚本 / 探针产物（含服务器地址与凭据，不进仓库）
.runtime/
# 从生产镜像里提取的浏览器插件包：构建产物，本地按需重建
.runtime-addons/
# 智谱清言冒烟用的项目与关键词池：示例配置，不是产品资产
examples/project.zhipu-smoke.json
examples/keyword-pool.zhipu-smoke.json
