{
  "name": "onegl-doubao-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "China-first GEO / AI citation intelligence MVP for Doubao Web",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth": "node src/cli.js auth",
    "run": "node src/cli.js run",
    "batch": "node src/cli.js batch",
    "runs": "node src/cli.js runs",
    "serve": "node src/server.js",
    "api:serve": "node src/api-entry.js",
    "webhook:worker": "node src/webhook-worker-entry.js",
    "monitor:worker": "node src/monitor-worker-entry.js",
    "alert:worker": "node src/alert-worker-entry.js",
    "runtime:check": "node tools/runtime-check.js",
    "storage:rotate": "node tools/storage-state-rotate.js",
    "audit:list": "node tools/audit-log.js",
    "ops:summary": "node tools/ops-summary.js",
    "slo:check": "node tools/slo-check.js",
    "openapi:build": "node tools/build-openapi.js",
    "openapi:lint": "npx --yes @redocly/cli@2 lint openapi.json",
    "openapi:types": "mkdir -p generated && npx --yes openapi-typescript@7 openapi.json -o generated/openapi.d.ts",
    "openapi:typecheck": "npx --yes -p typescript@5.9.2 tsc --noEmit generated/openapi.d.ts",
    "openapi:check": "npm run openapi:build && npm run openapi:lint && npm run openapi:types && npm run openapi:typecheck && node --test test/openapi-build.test.mjs test/openapi-contract-coverage.test.mjs test/openapi-patch-contract.test.mjs test/openapi-runtime-parity.test.mjs && git diff --exit-code -- openapi.json generated/openapi.d.ts",
    "check": "node --check src/*.js && node -e \"JSON.parse(require('fs').readFileSync('validation/phase0-prompts.json','utf8'))\"",
    "validate:scaffold": "node src/validate.js scaffold",
    "validate:evaluate": "node src/validate.js evaluate",
    "db:migrate": "node src/db/migrate.js",
    "db:status": "node src/db/migrate.js status",
    "db:tunnel": "node src/db/tunnel.js",
    "db:query": "node src/db/query.js",
    "project:init": "node src/cli.js project-init",
    "pool:list": "node src/cli.js pool-list",
    "sample": "node src/cli.js sample",
    "batch:run": "node src/cli.js batch-run",
    "batch:start": "node src/cli.js batch-start",
    "batch:stop": "node src/cli.js batch-stop",
    "worker": "node src/worker-entry.js",
    "risk:audit": "node tools/risk-audit.js",
    "page:capture": "node tools/page-evidence-capture.js",
    "source:intelligence": "node tools/source-intelligence-capture.js",
    "report": "node src/cli.js report",
    "report:retrieval": "node tools/retrieval-report.js",
    "report:factors": "node tools/citation-factor-report.js",
    "report:export": "node tools/export-batch.js",
    "report:html": "node tools/build-report-html.js",
    "fixtures:sanitize": "node tools/sanitize-fixtures.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "dotenv": "^17.2.3",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "playwright-core": "^1.51.1"
  }
}
