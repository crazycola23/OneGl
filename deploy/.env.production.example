# Copy to deploy/.env.production and replace every placeholder before starting containers.
# Keep this file outside source control after filling real values.

ONEGL_PRODUCTION=true
NODE_ENV=production

DATABASE_URL=postgresql://onegl:replace-me@db.example.internal:5432/onegl
REDIS_URL=redis://:replace-me@redis.example.internal:6379
ONEGL_QUEUE_PREFIX=onegl

ONEGL_API_KEY=replace-with-long-random-master-key
ONEGL_WEBHOOK_SIGNING_KEY=replace-with-at-least-32-random-characters
ONEGL_METRICS_TOKEN=replace-with-at-least-32-random-characters
ONEGL_ALERT_WEBHOOK_URL=https://ops.example.com/onegl-alerts
ONEGL_ALERT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Generate exactly 32 random bytes, for example:
# printf 'base64:' && openssl rand -base64 32
ONEGL_STORAGE_STATE_KEY=base64:replace-with-32-random-bytes
ONEGL_REQUIRE_STORAGE_STATE_ENCRYPTION=true

ONEGL_DATA_DIR=/var/lib/onegl
ONEGL_BROWSER=chromium
ONEGL_HEADLESS=true
ONEGL_BROWSER_LOCALE=zh-CN
ONEGL_BROWSER_TIMEZONE=Asia/Shanghai
ONEGL_BROWSER_VIEWPORT_WIDTH=1440
ONEGL_BROWSER_VIEWPORT_HEIGHT=900

ONEGL_API_RATE_LIMIT_PER_MINUTE=120
ONEGL_AUDIT_RETENTION_DAYS=30
ONEGL_ALERT_POLL_MS=60000
ONEGL_ALERT_REPEAT_MINUTES=60
ONEGL_SLO_WINDOW_MINUTES=15
ONEGL_SLO_API_MIN_REQUESTS=20
ONEGL_SLO_API_5XX_RATE_MAX=0.02
ONEGL_SLO_API_P95_MS_MAX=3000
ONEGL_SLO_EXECUTION_MIN_COUNT=5
ONEGL_SLO_EXECUTION_BAD_RATE_MAX=0.20
ONEGL_SLO_MANUAL_ACCOUNTS_MAX=0
ONEGL_SLO_FAILED_WEBHOOKS_MAX=0

ONEGL_ACCOUNT_PARALLELISM=1
ONEGL_ACCOUNT_HOURLY_LIMIT=10
ONEGL_ACCOUNT_DAILY_LIMIT=40
ONEGL_MIN_INTER_RUN_SECONDS=45
ONEGL_MIN_DELAY_MS=30000
ONEGL_MAX_DELAY_MS=90000
